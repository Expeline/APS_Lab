@startuml
!pragma teoz true
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam sequenceMessageAlign center
skinparam ArrowColor #236B8E
skinparam ParticipantBorderColor #236B8E
skinparam ParticipantBackgroundColor #EAF4FA

title Вариант 24 — полный сценарий центра рендеринга
actor "Источник задания" as Source
control "Движок событий" as Engine
control "Диспетчер постановки" as DP
queue "Буфер (Д1ОЗ3)" as Buf
control "Диспетчер выбора" as DV
collections "Пул приборов (Д2П2)" as Pool
participant "Вычислительный узел" as Worker
control "Календарь" as Cal
database "Статистика" as Stat
note over Source,Engine: ИБ / ИЗ2: бесконечные источники; интервал U(a,b)
== Обработка события GENERATE ==
Source -> Engine: generateJob(sourceId, t)
Engine -> Cal: schedule(next GENERATE, t + U(a,b))
Cal --> Engine: eventId
Engine -> DP: onArrival(job)
DP -> Buf: firstFreeSlot() [Д1ОЗ3]
Buf --> DP: slot / none
alt Есть место в буфере
 DP -> Buf: putAt(slot, job)
 Buf --> DP: placed
 DP -> Stat: recordBuffered(job)
else Буфер заполнен
 DP -> Buf: selectLowestPriorityVictim() [Д1ОО2]
 Buf --> DP: victim
 alt Новая заявка имеет право вытеснить victim
  note over DP,Buf
  Меньший номер источника = выше приоритет.
  При равенстве сохраняем старую заявку.
  end note
  DP -> Buf: remove(victim)
  Buf --> DP: removed
  DP -> Stat: recordRejected(victim, EVICTED)
  DP -> Buf: putAt(freedSlot, job)
  Buf --> DP: placed
 else Новая заявка не выше по приоритету
  DP -> Stat: recordRejected(job, OVERFLOW)
 end
end
== Обработка события COMPLETE ==
Worker -> Engine: onCompleted(job, workerId)
Engine -> Stat: recordCompleted(job, t)
Engine -> Pool: release(workerId)
Pool --> Engine: workerAvailable
Engine -> DV: onDeviceAvailable(t)
DV -> Buf: getWaitingJobs()
Buf --> DV: jobs
alt Пакет уже активен
 DV -> DV: Не расширять текущий пакет
else Нет активного пакета и очередь не пуста
 DV -> DV: selectPrioritySource(jobs) [Д2Б5]
 DV -> Buf: snapshotAndReserve(sourceId)
 Buf --> DV: immutable batchIds
 note over DV
 Пакет фиксирован в момент освобождения
 одного из приборов; все приборы обслуживают
 только этот пакет до полного завершения.
 end note
end
loop Пока есть свободные приборы и ожидающие заявки активного пакета
 DV -> Pool: findFreeFromPointer() [Д2П2]
 Pool --> DV: worker / none
 alt Найден свободный прибор
  DV -> Buf: takeReserved(batchJobId)
  Buf --> DV: job
  DV -> Pool: assignAndAdvancePointer(worker, job)
  Pool -> Worker: start(job, t, Exp(lambda)) [ПЗ1]
  Worker --> Pool: expectedFinishTime
  Pool --> DV: expectedFinishTime
  DV -> Cal: schedule(COMPLETE, expectedFinishTime)
  Cal --> DV: eventId
  DV -> Stat: recordStarted(job, worker)
 else Нет свободного прибора
  break Ждать COMPLETE
  end
 end
end
alt Активный пакет полностью выполнен
 DV -> DV: closeBatch()
 note over DV
 Следующий пакет — после завершения текущего,
 по актуальному буферу и текущему приоритету
 end note
note over Engine,Cal
Начальная доступность прибора — отдельный триггер запуска DV.
При одинаковом времени события обрабатываются детерминированно.
end note
@enduml
