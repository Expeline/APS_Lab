@startuml
skinparam backgroundColor white
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
title Вариант 24 — алгоритм обработки заявок

|Движок моделирования|
start
:Создать источники, буфер и приборы;
:Запланировать события генерации;

while (В календаре есть события?) is (да)
  :Взять ближайшее событие;
  :Установить модельное время;

  if (Это генерация заявки?) then (да)
    |Источник|
    :Сформировать задание (ИБ);
    :Запланировать следующую генерацию U(a,b) (ИЗ2);
    |Статистика|
    :Учесть поступление;
    |Диспетчер постановки|
    :Принять заявку;
    |Буфер|
    if (Есть свободное место?) then (да)
      :Выбрать первое свободное место (Д1ОЗ3);
      :Записать новую заявку;
    else (нет)
      :Найти наименее приоритетную ожидающую заявку (Д1ОО2);
      :Удалить выбранную заявку;
      |Статистика|
      :Учесть отказ вытесненной заявке;
      |Буфер|
      :Записать новую заявку в освобождённую ячейку;
      |Диспетчер выбора|
      :Учесть вытеснение ожидающей заявки пакета;
    endif
  else (нет)
    |Прибор|
    :Завершить рендеринг задания;
    :Освободить прибор;
    |Статистика|
    :Учесть завершение и время работы;
    |Диспетчер выбора|
    :Пометить завершённую заявку активного пакета;
  endif

  |Диспетчер выбора|
  if (Активный пакет полностью выполнен?) then (да)
    :Закрыть активный пакет;
  endif

  if (Есть свободный прибор?) then (да)
    if (Активного пакета нет?) then (да)
      |Буфер|
      if (Есть ожидающие заявки?) then (да)
        |Диспетчер выбора|
        :Выбрать наиболее приоритетный источник (Д2Б5);
        |Буфер|
        :Зафиксировать все ожидающие заявки этого источника;
        :Не расширять состав пакета;
      endif
    endif

    |Диспетчер выбора|
    while (Есть свободный прибор и невыданная заявка пакета?) is (да)
      |Прибор|
      :Найти свободный прибор от кольцевого указателя (Д2П2);
      |Буфер|
      :Извлечь заявку текущего пакета;
      |Прибор|
      :Назначить заявку и сдвинуть указатель;
      :Начать обработку Exp(lambda) (ПЗ1);
      |Движок моделирования|
      :Запланировать событие COMPLETE;
      |Статистика|
      :Учесть начало обслуживания;
      |Диспетчер выбора|
    endwhile (нет)
  endif

  |Движок моделирования|
  :Сохранить текущее состояние системы;
endwhile (нет)

|Статистика|
:Сформировать итоговую таблицу (ОР1);
stop
@enduml
