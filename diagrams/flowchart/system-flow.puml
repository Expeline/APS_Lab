@startuml
skinparam backgroundColor white
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
title Вариант 24 — flowchart с дорожками
|Движок моделирования|
start
:Инициализировать источники,
свободные узлы, буфер и календарь;
:Добавить первые GENERATE;
вызвать выбор при начальной доступности приборов;
while (Есть события или необработанные заявки?) is (да)
 :Извлечь ближайшее событие;
перевести модельное время;
 if (Тип = GENERATE?) then (да)
  |Источник|
  :Создать RenderJob [ИБ];
  :Запланировать следующий GENERATE
по U(a,b) [ИЗ2], пока лимит не достигнут;
  |Диспетчер постановки|
  :Получить заявку;
  |Буфер|
  if (Есть свободное место?) then (да)
   :Поместить в первую свободную
ячейку [Д1ОЗ3];
  else (нет)
   :Найти наименее приоритетную
заявку [Д1ОО2];
   |Диспетчер постановки|
   if (Новая заявка приоритетнее?) then (да)
    |Буфер|
    :Вытеснить старую и вставить новую;
    |Статистика|
    :Учесть отказ вытесненной;
   else (нет)
    |Статистика|
    :Учесть отказ новой заявки;
   endif
  endif
 else (нет — COMPLETE)
  |Приборы|
  :Завершить обработку;
освободить прибор;
  |Статистика|
  :Зафиксировать завершение,
время обслуживания и занятость;
  |Диспетчер выбора|
  :Триггер — освободился прибор;
 endif
 |Диспетчер выбора|
 if (Есть активный пакет?) then (да)
  :Работать только с его
необслуженными заявками;
 else (нет)
  |Буфер|
  if (Есть ожидающие заявки?) then (да)
   |Диспетчер выбора|
   :Выбрать источник с наивысшим приоритетом [Д2Б5];
   |Буфер|
   :Снять снимок заявок источника;
зафиксировать пакет без расширения;
  endif
 endif
 |Диспетчер выбора|
 while (Есть свободный прибор И ожидающая заявка пакета?) is (да)
  |Приборы|
  :Выбрать свободный прибор
по кольцу [Д2П2];
  |Буфер|
  :Выбрать зарезервированную заявку;
  |Приборы|
  :Начать обслуживание по Exp(lambda) [ПЗ1];
  |Движок моделирования|
  :Добавить COMPLETE в календарь;
  |Статистика|
  :Учесть начало обработки;
  |Диспетчер выбора|
 endwhile (нет)
 if (Все заявки активного пакета завершены?) then (да)
  :Закрыть пакет;
следующий пакет только после завершения текущего;
 endif
 |Движок моделирования|
endwhile (нет)
|Статистика|
:Вывести ОР1 — сводную таблицу;
сохранить состояния пошагового режима;
stop
@enduml
