@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam classAttributeIconSize 0
title Вариант 24 — диаграмма классов СМО рендеринга

class RenderingSimulation {
  - clock : double
  - sources : Source[]
  - placement : PlacementDispatcher
  - selection : SelectionDispatcher
  - pool : DevicePool
  - buffer : JobBuffer
  - calendar : EventCalendar
  - statistics : Statistics
  + initialize() : void
  + run(limit : int) : Summary
  + process(event : Event) : void
}

class Source {
  - id : int
  - distribution : UniformDistribution
  - produced : int
  + generate(at : double) : RenderJob
  + nextDelay() : double
}

class UniformDistribution {
  - minInterval : double
  - maxInterval : double
  + sample() : double
}

class RenderJob {
  - id : long
  - sourceId : int
  - arrivedAt : double
  - startedAt : double
  - finishedAt : double
  - status : JobStatus
}

enum JobStatus {
  CREATED
  BUFFERED
  RESERVED
  RUNNING
  COMPLETED
  REJECTED
}

class PlacementDispatcher {
  - buffer : JobBuffer
  - statistics : Statistics
  + onArrival(job : RenderJob) : void
  - findVictim() : RenderJob
}

class JobBuffer {
  - capacity : int
  - slots : RenderJob[]
  + firstFreeSlot() : int
  + putAt(slot : int, job : RenderJob) : void
  + remove(job : RenderJob) : int
  + selectLowestPriorityVictim() : RenderJob
  + waitingJobs() : RenderJob[]
  + snapshotBatch(sourceId : int) : JobBatch
  + takeReserved(jobId : long) : RenderJob
}

class SelectionDispatcher {
  - buffer : JobBuffer
  - pool : DevicePool
  - calendar : EventCalendar
  - statistics : Statistics
  - activeBatch : JobBatch
  + onDeviceAvailable(at : double) : void
  + onCompleted(jobId : long) : void
  - selectPrioritySource() : int
  - dispatchAvailable() : void
}

class JobBatch {
  - sourceId : int
  - fixedJobIds : long[]
  - runningIds : long[]
  - completedIds : long[]
  + nextWaitingId() : long
  + markStarted(jobId : long) : void
  + markCompleted(jobId : long) : void
  + isFinished() : boolean
}

class DevicePool {
  - workers : RenderWorker[]
  - ringPointer : int
  + findFreeCircular() : RenderWorker
  + assignAndAdvance(worker : RenderWorker, job : RenderJob) : double
  + release(workerId : int) : void
}

class RenderWorker {
  - id : int
  - currentJob : RenderJob
  - busySince : double
  - serviceLaw : ExponentialDistribution
  + start(job : RenderJob, at : double) : double
  + complete(at : double) : RenderJob
  + isFree() : boolean
}

class ExponentialDistribution {
  - rate : double
  + sample() : double
}

class EventCalendar {
  - events : PriorityQueue
  + schedule(event : Event) : void
  + popNext() : Event
  + isEmpty() : boolean
}

class Event {
  - time : double
  - type : EventType
  - jobId : long
  - workerId : int
}

enum EventType {
  GENERATE
  COMPLETE
}

class Statistics {
  - generatedBySource : Map
  - rejectedBySource : Map
  - completedBySource : Map
  - busyTimeByWorker : Map
  + recordGenerated(job : RenderJob) : void
  + recordRejected(job : RenderJob) : void
  + recordStarted(job : RenderJob, workerId : int) : void
  + recordCompleted(job : RenderJob) : void
  + summarize(totalTime : double) : Summary
}

class Summary {
  + rejectionProbability : Map
  + meanWaitingTime : Map
  + meanServiceTime : Map
  + meanSystemTime : Map
  + workerUtilization : Map
}

RenderingSimulation *-- Source
RenderingSimulation *-- PlacementDispatcher
RenderingSimulation *-- SelectionDispatcher
RenderingSimulation *-- JobBuffer
RenderingSimulation *-- DevicePool
RenderingSimulation *-- EventCalendar
RenderingSimulation *-- Statistics
Source --> UniformDistribution
Source ..> RenderJob : создаёт
RenderJob --> JobStatus
PlacementDispatcher --> JobBuffer
PlacementDispatcher --> Statistics
SelectionDispatcher --> JobBuffer
SelectionDispatcher --> DevicePool
SelectionDispatcher --> EventCalendar
SelectionDispatcher --> Statistics
SelectionDispatcher o-- JobBatch
JobBatch ..> RenderJob : фиксирует идентификаторы
JobBuffer o-- RenderJob
DevicePool *-- RenderWorker
RenderWorker --> ExponentialDistribution
RenderWorker --> RenderJob
EventCalendar o-- Event
Event --> EventType
Statistics ..> Summary

note bottom of JobBatch
  Д2Б5: в пакет попадают заявки одного
  источника, ожидающие в момент его создания.
  Новые заявки не добавляются в пакет.
end note

note bottom of DevicePool
  Д2П2: поиск свободного прибора по кольцу.
end note
@enduml
